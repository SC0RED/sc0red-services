{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "WhatsMissingGaps",
    "description": "Per-call schema for the decomposed holistic gaps call. Replaces the whatsMissing portion of the legacy 07_arrows_and_gaps call. 2-4 gaps, each with a deep-dive framing.",
    "type": "object",
    "required": ["whatsMissing"],
    "additionalProperties": false,
    "properties": {
        "whatsMissing": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
                "type": "object",
                "required": ["id", "title", "description", "deepDiveFraming"],
                "additionalProperties": false,
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^G[1-9]$"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 4,
                        "maxLength": 100
                    },
                    "description": {
                        "type": "string",
                        "minLength": 30,
                        "maxLength": 600
                    },
                    "deepDiveFraming": {
                        "type": "string",
                        "minLength": 30,
                        "maxLength": 400
                    },
                    "relatedObjectiveIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
