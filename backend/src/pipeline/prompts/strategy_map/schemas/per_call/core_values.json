{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CoreValues",
    "description": "Per-call schema for the core-values output. Same shape as the `coreValues` block in the assembled strategy-map output. Kept as its own per-call file so the value-discovery prompt can target it specifically.",
    "type": "object",
    "required": ["values", "synthesised", "rationale"],
    "additionalProperties": false,
    "properties": {
        "values": {
            "type": "array",
            "minItems": 3,
            "maxItems": 6,
            "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 60
            }
        },
        "synthesised": {
            "type": "boolean"
        },
        "rationale": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
        }
    }
}
