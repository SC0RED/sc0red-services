{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InternalProcessThemes",
    "description": "Per-call schema for internal-processes Round 1 (theme list). 2-3 themes; each theme names which financial objectives it supports (by F1/F2/F3 ID, set by assembly when financial titles are processed). IDs for inner objectives are assigned by assembly per Decision §2.",
    "type": "object",
    "required": ["themes"],
    "additionalProperties": false,
    "properties": {
        "themes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
                "type": "object",
                "required": ["name", "supports_financial_objectives"],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 4,
                        "maxLength": 60
                    },
                    "supports_financial_objectives": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "pattern": "^F[123]$"
                        }
                    }
                }
            }
        }
    }
}
