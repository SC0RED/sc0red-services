# Python backend URL (server-side only — no NEXT_PUBLIC_ prefix)
BACKEND_URL=http://localhost:8001

# NextAuth configuration
NEXTAUTH_SECRET=your_32_char_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# sc0red CTA contact URL (optional — defaults to https://www.sc0red.com/contact)
# Override per environment if needed (e.g. staging contact form, Calendly link).
# NEXT_PUBLIC_ prefix makes it available client-side.
# NEXT_PUBLIC_SC0RED_CONTACT_URL=https://www.sc0red.com/contact
